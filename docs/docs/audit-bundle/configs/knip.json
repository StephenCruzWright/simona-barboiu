{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/page.{ts,tsx}",
    "src/app/**/layout.{ts,tsx}",
    "src/app/**/{loading,error,global-error,not-found,template}.{ts,tsx}",
    "src/app/{robots,sitemap,manifest,opengraph-image,twitter-image,icon,apple-icon}.{ts,tsx}",
    "src/app/**/{robots,sitemap}.{ts,tsx}",
    "src/app/**/route.{ts,tsx}",
    "next.config.ts",
    "scripts/*.{mjs,ts,js}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts,js}"],
  "ignore": ["**/node_modules/**", ".next/**"],
  "ignoreDependencies": ["@vercel/speed-insights", "@vercel/analytics"]
}
